{
    "id": "devLauncher",
    "name": "Dev Launcher",
    "description": "Swiftly find local Git repositories and recently opened projects and files in IDEs in the Dux launcher.",
    "version": "1.0.0",
    "author": "TMS-Namespace",
    "type": "composite",
    "capabilities": ["daemon", "launcher"],
    "components": {
        "daemon": "./src/Plugin/QML/Services/ScanOrchestrator.qml",
        "launcher": "./src/Plugin/QML/Launcher.qml"
    },
    "settings": "./src/Plugin/QML/Settings.qml",
    "trigger": "`",
    "icon": "account_tree",
    "category": "productivity",
    "repo": "https://github.com/TMS-Namespace/Dux-VS-Code-Recents-Plugin",
    "permissions": ["settings_read", "settings_write", "process"],
    "requires_dms": ">=2.0.0",
    "distro": ["any"],
    "compositors": ["any"],
    "dependencies": ["find", "timeout", "stat", "cat", "head", "which", "test", "xdg-open"]
}
